PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/anisave
JWT_SECRET=replace_with_a_long_random_secret
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Gmail SMTP for sending password reset emails.
# EMAIL_USER is your full Gmail address.
# EMAIL_PASS is a 16-character Gmail "App Password" - NOT your normal Gmail password.
# Generate one at https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled).
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_character_app_password
