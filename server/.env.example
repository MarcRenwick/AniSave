PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/anisave
# A long random value (32+ characters) - sessions are signed with it. Never commit the real one.
JWT_SECRET=replace_with_a_long_random_secret
# Use "production" when deployed: hides internals and enforces a strong JWT_SECRET.
NODE_ENV=development
# The website's address. Only it may call the API from a browser (CORS).
# Comma-separate several: http://localhost:5173,https://anisave.example
CLIENT_URL=http://localhost:5173
# Optional: how long a login lasts (default 7d)
# JWT_EXPIRES_IN=7d

# Gmail SMTP for sending one-time codes (password reset, login, two-step sign-in).
# EMAIL_USER is your full Gmail address.
# EMAIL_PASS is a 16-character Gmail "App Password" - NOT your normal Gmail password.
# Generate one at https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled).
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_character_app_password

# Needed on a host that blocks SMTP. Render's free instances refuse outbound
# traffic on ports 25, 465 and 587, so Gmail is unreachable from there and every
# code times out. With this set, mail goes to the relay in
# client/api/send-email.js, deployed on Vercel with the website, which sends it
# through Gmail from there. Give the Vercel project the same EMAIL_USER and
# EMAIL_PASS: requests to the relay are signed with EMAIL_PASS.
# MAIL_RELAY_URL=https://your-site.vercel.app/api/send-email

# Or, instead of the relay, Brevo's HTTPS API: mail still goes from EMAIL_USER
# (verify that address as a sender in Brevo first), and EMAIL_PASS is not used.
# Create a key at brevo.com: SMTP & API > API Keys.
# BREVO_API_KEY=your_brevo_api_key
